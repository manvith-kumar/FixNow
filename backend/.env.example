# ---- Server ----
NODE_ENV=development
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173

# ---- MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fixnow
DB_USER=root
DB_PASSWORD=change_me
DB_CONNECTION_LIMIT=10

# ---- Auth (use a long random string; generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ----
JWT_SECRET=replace-with-at-least-32-characters-of-random-text
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10
PASSWORD_RESET_TTL_MINUTES=30
# Development only: include the reset token in the forgot-password response. Ignored in production.
DEV_EXPOSE_RESET_TOKEN=true

# ---- Uploads ----
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_MB=5

# ---- Optional email provider (not required; if unset no email is sent or claimed) ----
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=FixNow <no-reply@fixnow.example>

# ---- Rate limiting ----
AUTH_RATE_LIMIT_MAX=20
